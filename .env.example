# Copy to .env and fill only the providers you have configured.

# Existing scraper settings
GOOGLE_MAPS_API_KEY=

# Optional enrichment; keep disabled unless explicitly enabled.
TAVILY_API_KEY=
ENABLE_TAVILY=false

# Email SMTP
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

